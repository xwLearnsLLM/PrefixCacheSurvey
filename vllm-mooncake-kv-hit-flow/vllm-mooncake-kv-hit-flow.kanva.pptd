version: v2
title: vLLM + Mooncake Store KV Cache 命中流程
size: [1920, 1200]
theme:
  colors:
    background: "#F5F2EC"
    surface: "#FCFBF8"
    ink: "#1F2D2A"
    muted: "#66736F"
    primary: "#173E38"
    managed: "#19705B"
    integrated: "#A86622"
    dataplane: "#52748C"
    remoteSsd: "#80663F"
    grid: "#CBD3CE"
    control: "#78847F"
  textStyles:
    title:
      fontSize: 43
      fontFamily: 微软雅黑
      color: "$ink"
      bold: true
      letterSpacing: -1
    subtitle:
      fontSize: 18
      fontFamily: 微软雅黑
      color: "$muted"
    boxTitle:
      fontSize: 20
      fontFamily: 微软雅黑
      color: "$ink"
      bold: true
      lineHeight: 1.2
    body:
      fontSize: 16
      fontFamily: 微软雅黑
      color: "$ink"
      lineHeight: 1.28
    small:
      fontSize: 13
      fontFamily: 微软雅黑
      color: "$muted"
      lineHeight: 1.3
pages:
  - pages/1_hit_flow.page
