    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="font-size:20px;color:$remoteSsd"><strong>分布式 SSD</strong></span></p>
        <p><span style="color:$muted">远端 Client 的本地盘</span></p>
  - elementId: control-remote-ssd
