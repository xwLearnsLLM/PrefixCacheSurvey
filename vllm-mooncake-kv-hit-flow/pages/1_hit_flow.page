    content:
      style: "$body"
      align: [center, middle]
      text: |
        <p><span style="font-size:20px"><strong>请求到达</strong></span></p>
        <p><span style="color:$muted">Tokenize 后的 Prompt</span></p>
  - elementId: arrow-request-hash
