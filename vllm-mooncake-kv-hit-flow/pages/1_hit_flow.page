      align: [center, middle]
      text: |
        <p><span style="font-size:20px"><strong>生成 Block Key</strong></span></p>
        <p><span style="color:$muted">内容寻址 Hash／Chunk</span></p>
  - elementId: arrow-hash-hbm
    elementType: line
    bounds: [650, 224, 60, 2]
    viewBox: [60, 2]
    points: "0,1 60,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2, color: "$control"}
  - elementId: hbm-box
