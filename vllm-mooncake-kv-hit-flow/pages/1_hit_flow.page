    bounds: [876, 451, 610, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="color:$managed"><strong>本地 memcpy／注册内存读取</strong></span></p>
        <p><span style="color:$muted">→ 本地接收 Buffer → H2D</span></p>
  - elementId: arrow-local-dram-target
    elementType: line
    bounds: [1510, 489, 70, 2]
    viewBox: [70, 2]
    points: "0,1 70,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$managed"}

  - elementId: local-ssd-band
    elementType: shape
    bounds: [60, 565, 1450, 100]
