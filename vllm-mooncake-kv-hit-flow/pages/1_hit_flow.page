  - elementId: arrow-remote-ssd-data
    elementType: line
    bounds: [810, 864, 50, 2]
    viewBox: [50, 2]
    points: "0,1 50,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$remoteSsd"}
  - elementId: remote-ssd-data
    elementType: text
    bounds: [876, 826, 610, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="color:$remoteSsd"><strong>所属 Client 读盘 → RDMA／TCP</strong></span></p>
        <p><span style="color:$muted">→ 本地接收 Buffer → H2D</span></p>
  - elementId: arrow-remote-ssd-target
    elementType: line
    bounds: [1510, 864, 70, 2]
    viewBox: [70, 2]
    points: "0,1 70,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$remoteSsd"}

  - elementId: hbm-target-box
