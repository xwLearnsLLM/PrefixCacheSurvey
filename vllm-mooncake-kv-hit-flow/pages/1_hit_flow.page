    bounds: [1510, 739, 70, 2]
    viewBox: [70, 2]
    points: "0,1 70,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$dataplane"}

  - elementId: remote-ssd-band
