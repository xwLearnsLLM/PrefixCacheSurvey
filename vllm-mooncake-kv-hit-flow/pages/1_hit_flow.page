    border: {style: solid, width: 1, color: "$grid"}
  - elementId: local-dram-label
    elementType: text
    bounds: [76, 451, 188, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="font-size:20px;color:$managed"><strong>本地 DRAM</strong></span></p>
        <p><span style="color:$muted">本机 Mooncake Client</span></p>
  - elementId: control-local-dram
