pageType: content
background: {type: solid, color: "$background"}
notes: 范围是 MooncakeStoreConnector 的跨请求前缀复用，不是 MooncakeConnector 的 P/D 实时传输。虚线为控制与元数据路径，实线为 KV 数据路径。外部四类介质表示 Master 可能返回的副本位置，不是逐级串行查询。
elements:
  - elementId: kicker
    elementType: text
    bounds: [58, 28, 700, 24]
    content: {fontSize: 13, fontFamily: 微软雅黑, bold: true, color: "$managed", letterSpacing: 2, wrap: false, text: "PREFIX CACHE LOOKUP / 跨请求前缀复用"}
  - elementId: title
    elementType: text
    bounds: [56, 55, 1250, 58]
    content: {style: "$title", wrap: false, align: [left, middle], text: "vLLM + Mooncake Store｜KV Cache 命中流程"}
  - elementId: subtitle
    elementType: text
    bounds: [58, 118, 1100, 28]
    content: {style: "$subtitle", wrap: false, text: "五级介质｜一次外部元数据查询｜按副本位置取数｜最终回填 HBM Block"}
  - elementId: legend
    elementType: text
    bounds: [1190, 112, 672, 40]
    content:
      fontSize: 13
      fontFamily: 微软雅黑
      color: "$muted"
      align: [right, middle]
      wrap: false
      text: |
        <p><span style="color:$control">┄ 控制／元数据</span>　<span style="color:$managed">─ 本地数据</span>　<span style="color:$dataplane">─ 远端数据</span>　<span style="color:$integrated">─ SSD 数据</span></p>
  - elementId: top-rule
    elementType: shape
    bounds: [56, 154, 1808, 2]
    shapeName: rect
    fill: {type: solid, color: "$primary"}

  - elementId: request-box
