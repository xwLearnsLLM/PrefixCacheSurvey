    elementType: text
    bounds: [76, 576, 188, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="font-size:20px;color:$integrated"><strong>本地 SSD</strong></span></p>
        <p><span style="color:$muted">本机 Client 的 NVMe</span></p>
  - elementId: control-local-ssd
    elementType: line
    bounds: [300, 614, 30, 2]
    viewBox: [30, 2]
    points: "0,1 30,1"
    arrow: [null, stealth]
    border: {style: dash, width: 1.5, color: "$control"}
  - elementId: local-ssd-location
    elementType: text
    bounds: [346, 576, 440, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><strong>返回 LOCAL_DISK 副本</strong></p>
        <p><span style="color:$muted">DRAM Miss 后由所属 Client 读盘</span></p>
  - elementId: arrow-local-ssd-data
    elementType: line
    bounds: [810, 614, 50, 2]
    viewBox: [50, 2]
    points: "0,1 50,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$integrated"}
  - elementId: local-ssd-data
    elementType: text
    bounds: [876, 576, 610, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="color:$integrated"><strong>SSD 读取 → 本地 DRAM／接收 Buffer</strong></span></p>
        <p><span style="color:$muted">→ H2D；热数据可按策略提升到 DRAM</span></p>
  - elementId: arrow-local-ssd-target
