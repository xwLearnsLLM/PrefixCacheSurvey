    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="font-size:20px;color:$dataplane"><strong>分布式 DRAM</strong></span></p>
        <p><span style="color:$muted">远端 Mooncake Client</span></p>
  - elementId: control-remote-dram
    elementType: line
    bounds: [300, 739, 30, 2]
    viewBox: [30, 2]
    points: "0,1 30,1"
    arrow: [null, stealth]
    border: {style: dash, width: 1.5, color: "$control"}
  - elementId: remote-dram-location
    elementType: text
    bounds: [346, 701, 440, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><strong>返回远端内存副本</strong></p>
        <p><span style="color:$muted">Master 定位拥有副本的 Client</span></p>
  - elementId: arrow-remote-dram-data
    elementType: line
    bounds: [810, 739, 50, 2]
    viewBox: [50, 2]
    points: "0,1 50,1"
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$dataplane"}
  - elementId: remote-dram-data
    elementType: text
    bounds: [876, 701, 610, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><span style="color:$dataplane"><strong>Transfer Engine：RDMA／TCP P2P</strong></span></p>
        <p><span style="color:$muted">远端 Client DRAM → 本地 Buffer → H2D</span></p>
  - elementId: arrow-remote-dram-target
