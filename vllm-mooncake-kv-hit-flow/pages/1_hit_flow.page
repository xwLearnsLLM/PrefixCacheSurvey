    viewBox: [30, 2]
    points: "0,1 30,1"
    arrow: [null, stealth]
    border: {style: dash, width: 1.5, color: "$control"}
  - elementId: remote-ssd-location
    elementType: text
    bounds: [346, 826, 440, 78]
    content:
      style: "$body"
      align: [left, middle]
      text: |
        <p><strong>返回远端 SSD／DFS 副本</strong></p>
