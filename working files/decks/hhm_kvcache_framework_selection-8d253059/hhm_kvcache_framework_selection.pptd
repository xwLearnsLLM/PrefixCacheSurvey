version: v2
title: HHM KVcache 管理框架选型
size: [960, 540]
theme:
  colors:
    bg: "#F7F6F2"
    ink: "#1F292E"
    muted: "#667176"
    faint: "#98A1A4"
    line: "#D6DAD6"
    white: "#FFFFFF"
    structural: "#315F5C"
    structuralLight: "#E4EEEA"
    accent: "#C66A32"
    accentLight: "#F4E7DB"
    panel: "#F0F1ED"
  textStyles:
    title:
      fontFamily: 微软雅黑
      fontSize: 26
      bold: true
      color: "$ink"
      lineHeight: 1.15
    subtitle:
      fontFamily: 微软雅黑
      fontSize: 12
      color: "$muted"
      lineHeight: 1.3
    section:
      fontFamily: 微软雅黑
      fontSize: 18
      bold: true
      color: "$ink"
    body:
      fontFamily: 微软雅黑
      fontSize: 12
      color: "$ink"
      lineHeight: 1.35
    small:
      fontFamily: 微软雅黑
      fontSize: 10
      color: "$muted"
      lineHeight: 1.25
    node:
      fontFamily: 微软雅黑
      fontSize: 12
      bold: true
      color: "$ink"
      lineHeight: 1.2
pages:
  - pages/1_hicache.page
  - pages/2_lmcache.page
  - pages/3_mooncake.page
  - pages/4_memcache.page
  - pages/5_selection.page
